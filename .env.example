# Breez SDK
BREEZ_API_KEY=your-breez-api-key
BREEZ_MNEMONIC=word1 word2 word3 ... word12
# mainnet or regtest
BREEZ_NETWORK=mainnet
BREEZ_WORKING_DIR=./data/breez

# Inbound auth — Moodle sends this on POST /pay / GET /status.
INTERNAL_TOKEN=change-me-to-a-strong-secret

# Outbound webhook — terminal payment events are POSTed here (retried forever).
# Moodle plugin must expose an idempotent endpoint that verifies the
# X-Webhook-Signature: sha256=<hex> header using WEBHOOK_SECRET.
MOODLE_WEBHOOK_URL=https://moodle.example.com/local/btcrewards/webhook.php
WEBHOOK_SECRET=change-me-to-a-separate-strong-secret

# Service
HOST=0.0.0.0
PORT=3000
